{
  "name": "@mambalabsdev/mcp-domain-to-linkedin-url-resolver",
  "version": "1.2.2",
  "description": "MCP server for Domain to LinkedIn URL Resolver. Resolves a company domain or name to its LinkedIn company URL from public search results, with confidence scoring and optional firmographics from search snippets. Never requests a LinkedIn page. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-domain-to-linkedin-url-resolver": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "linkedin",
    "company-url",
    "firmographics",
    "apify",
    "clay",
    "lead-generation"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/domain-to-linkedin-url-resolver",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-domain-to-linkedin-url-resolver"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-domain-to-linkedin-url-resolver"
}
